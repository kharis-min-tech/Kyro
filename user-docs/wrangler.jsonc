{
  // The user guide is a separate Cloudflare Worker (static, plus video ranges). Having its
  // own config here stops wrangler from picking up the dashboard's
  // ../wrangler.jsonc (which carries the API script, KV and cron).
  "name": "kyro-user-documentation",
  "account_id": "a94432b07dae8050b83efdec72a492a3",
  "compatibility_date": "2026-10-01",
  // A tiny script only for /videos/* (byte ranges, so iPhones can play the
  // tour video); every other path is served straight from the assets.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/videos/*"]
  },
  // The guide's own address on the Kharis domain (custom domain → this Worker).
  "routes": [
    { "pattern": "kyro-help.kharischurch.com", "custom_domain": true }
  ],

  // No schedule for the guide.
  "triggers": { "crons": [] }
}
