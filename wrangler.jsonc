{
  // Workers Static Assets config.
  //
  // Context: the Cloudflare project `kyrokharis` was created as a Workers
  // project (not Pages), so its deploy step runs `wrangler deploy`. By
  // default that command has no idea what to deploy — hence the earlier
  // "Could not detect a directory containing static files" errors.
  //
  // This file tells wrangler two things:
  //   1. The project name on Cloudflare, so the right service is updated.
  //   2. That we're deploying a bundle of static files produced by
  //      `next build` (with output: 'export'), located at dashboard/out.
  //
  // SPA 404-handling returns
  // index.html for any unknown path, which Next.js's static export
  // relies on for client-side routing (e.g. navigating from /seating
  // to /attendance without a full page reload).

  "name": "kyrokharis",
  "compatibility_date": "2026-10-01",

  // A small Worker script now runs in front of the assets, but ONLY for
  // /api/* (run_worker_first) — it relays Integrations webhooks
  // server-side (no CORS) and sends real Web Push notifications. Every
  // other path is still served straight from the static export.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dashboard/out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // VAPID public key is public by design. The matching private key is a
  // secret — set it once with:  npx wrangler secret put VAPID_PRIVATE_KEY
  // (or Cloudflare dashboard → Workers → kyrokharis → Settings → Variables).
  "vars": {
    "VAPID_PUBLIC_KEY": "BOY5WhHRwx4ICdijWbbp-Us0WZYDXXAE3T3dS2HpjnV0RMHuaPC1YMRn1zxsiwFFDofA9uF4O4erDCY16RLKLMU",
    "VAPID_SUBJECT": "mailto:admin@kyro.app"
  }
}
