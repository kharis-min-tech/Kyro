# A TEMPLATE. Every value marked change-me below is a placeholder.
# A placeholder that ships in a public repository is not a secret: anybody can
# read it here. `bash setup.sh` writes a real .env with generated values; this
# file is only the shape of one.
#
# `.env` is git-ignored — never commit real secrets.
#
# By hand:  openssl rand -hex 32   for each of the two secrets below.
#
# The API refuses to start while KYRO_JWT_SECRET is still the placeholder, on
# purpose: that secret is what signs session tokens, so a published one means
# anybody can forge a session for any account.

# ─── Backend (FastAPI) ───────────────────────────────────────────────────────
KYRO_JWT_SECRET=change-me-openssl-rand-hex-32
KYRO_API_KEY=change-me-openssl-rand-hex-32
KYRO_JWT_EXPIRY_HOURS=24

# Dashboard admin fallback account (only used if no DB user exists).
# setup.sh generates this one and shows it to you once.
KYRO_DASHBOARD_USER=admin
KYRO_DASHBOARD_PASS=change-me-strong-password

# How long a token for an <img> or a WebSocket is worth anything, in seconds.
# Those cannot carry a header, so their token goes in the URL — and a URL is
# written to access logs, proxies and browser history. Short on purpose.
KYRO_STREAM_TOKEN_TTL_S=300

# Login rate-limit (per IP): max attempts per window (seconds).
KYRO_LOGIN_RATE_MAX_HITS=10
KYRO_LOGIN_RATE_WINDOW_S=60

# CORS: comma-separated origins allowed to call the API.
# Example: https://kyro.kharischurch.com,https://staging.kyro.kharischurch.com
ALLOWED_ORIGINS=

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=kyro
POSTGRES_USER=kyro
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://kyro:change-me-strong-password@postgres:5432/kyro

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate a pair with:
#   pip install pywebpush && python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key_pem().decode()); print(v.private_key_pem().decode())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain

# ─── Vision worker ───────────────────────────────────────────────────────────
DETECTION_DEVICE=cpu
CAMERA_ID=cam-01
STREAM_SOURCE=/dev/video0
